# Modèle de configuration CoopHabitat — copier en .env puis remplir. Ne jamais versionner .env.
# Générer un secret : openssl rand -base64 48

# --- Environnement : DEVELOPPEMENT, TEST, DEMONSTRATION ou PRODUCTION
COOPHABITAT_ENVIRONMENT=PRODUCTION
COOPHABITAT_VERSION=local

# --- Adresse publique HTTPS de l'application (sert aux liens des courriels et à la politique CORS)
COOPHABITAT_PUBLIC_URL=https://coophabitat.example.invalid
# Le conteneur web écoute sur cette interface et ce port de l'hôte ; placer un reverse proxy HTTPS devant.
COOPHABITAT_HTTP_BIND=127.0.0.1
COOPHABITAT_HTTP_PORT=8080

# --- Base de données
COOPHABITAT_DB_NAME=coophabitat
COOPHABITAT_DB_USER=coophabitat
COOPHABITAT_DB_PASSWORD=

# --- Sécurité (32 caractères minimum, aléatoire, propre à chaque installation)
COOPHABITAT_JWT_SECRET=
COOPHABITAT_COOKIE_SECURE=true
# Premier administrateur : un lien d'activation à usage unique est journalisé au premier démarrage.
COOPHABITAT_BOOTSTRAP_ADMIN_EMAIL=
COOPHABITAT_SWAGGER_ENABLED=false

# --- Paiement Wave (Checkout API). Laisser false tant que le contrat marchand et les clés ne sont pas obtenus.
COOPHABITAT_WAVE_ENABLED=false
COOPHABITAT_WAVE_API_KEY=
COOPHABITAT_WAVE_WEBHOOK_SECRET=
COOPHABITAT_WAVE_SUCCESS_URL=https://coophabitat.example.invalid/espace/paiements
COOPHABITAT_WAVE_ERROR_URL=https://coophabitat.example.invalid/espace/paiements

# --- Simulateur de paiement : interdit en PRODUCTION (le serveur refuse de démarrer).
COOPHABITAT_PAYMENT_MOCK_ENABLED=false
COOPHABITAT_PAYMENT_MOCK_SECRET=

# --- Courriel (facultatif). Sans SMTP, les notifications restent dans l'application.
COOPHABITAT_MAIL_ENABLED=false
COOPHABITAT_MAIL_FROM=
COOPHABITAT_SMTP_HOST=
COOPHABITAT_SMTP_PORT=587
COOPHABITAT_SMTP_USER=
COOPHABITAT_SMTP_PASSWORD=

# --- Données de démonstration : interdites en PRODUCTION. Utilisées seulement avec docker-compose.demo.yml.
COOPHABITAT_DEMO_ENABLED=false
COOPHABITAT_DEMO_PASSWORD=
